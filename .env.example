# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (Bound to 3000)
PORT=3000

# PostgreSQL Database Connection URL (for VPS docker-compose or hosted DB)
DATABASE_URL="postgresql://eventops_user:eventops_password@postgres:5432/eventops_db"

# Redis Cache URL
REDIS_URL="redis://redis:6379"

# MinIO Object Storage Configuration
MINIO_ENDPOINT="http://minio:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="eventops-uploads"
MINIO_REGION="us-east-1"
MINIO_PUBLIC_URL="http://localhost:9000"

# Platform Branding Name (Configurable for custom branding / whitelabel)
PLATFORM_NAME="طهرون ایونتس"
VITE_PLATFORM_NAME="طهرون ایونتس"

# SMS.ir Integration
# API key from panel.sms.ir (Leave empty to use Dev-Simulated OTP and Notification mode)
SMS_IR_API_KEY=""
# Verification OTP Template ID in SMS.ir panel (e.g. 100000)
SMS_IR_TEMPLATE_ID=""
# SMS.ir Line Number for direct/bulk messages (e.g. 3000...)
SMS_IR_LINE_NUMBER=""
# Optional SMS.ir Template IDs for fast pattern delivery
SMS_IR_VENDOR_REQUEST_TEMPLATE_ID=""
SMS_IR_STATUS_UPDATE_TEMPLATE_ID=""
SMS_IR_ADMIN_ALERT_TEMPLATE_ID=""

# Admin notification phone numbers (Optional fallback; system automatically queries all users with role='admin' from the database)
ADMIN_PHONES=""

# Admin Passcode / Master Secret Key (Used in Admin Login modal to log in directly without SMS OTP)
ADMIN_SECRET_KEY=""
JWT_SECRET=""
