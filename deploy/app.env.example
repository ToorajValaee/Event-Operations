APP_URL=https://your-domain.example
JWT_SECRET=REPLACE_WITH_32_BYTE_OR_LONGER_RANDOM_VALUE
ADMIN_SECRET_KEY=REPLACE_WITH_UNIQUE_RANDOM_VALUE
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=
