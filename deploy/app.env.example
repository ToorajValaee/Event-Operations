# Copy to /opt/event-operations/production/.env.prod (never commit actual values)
# Preserve the values from the existing VPS .env.prod, especially for uploads/SMS.
APP_URL=https://tehroonevents.ir
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@postgres:5432/eventops_db
REDIS_URL=redis://:URL_ENCODED_PASSWORD@redis:6379
MINIO_ENDPOINT=http://minio-minio-1:9000
MINIO_ACCESS_KEY=REPLACE_WITH_EXISTING_KEY
MINIO_SECRET_KEY=REPLACE_WITH_EXISTING_SECRET
MINIO_BUCKET=eventops-uploads
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
ADMIN_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
MINIO_PUBLIC_URL=https://tehroonevents.ir/uploads
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=
